# Base URL of the Fluxel Rust API (no trailing slash).
#
# Server-side only — never prefixed with NEXT_PUBLIC_. The browser never talks
# to this host directly: the Rust API applies no CORS layer (tower-http's
# `cors` feature is enabled in its Cargo.toml but api/src/main.rs never adds
# the layer), so every call is proxied through the route handlers in app/api/.
#
# Sandbox:   https://apy.wiyuapp.com
# Local API: http://localhost:8080   (see Fluxel-System/infra/SETUP.md)
FLUXEL_API_URL=https://apy.wiyuapp.com

# Encrypts the dashboard's API-key cookie (see app/lib/server/consoleKeys.ts).
# Required in production — any long random string, e.g. `openssl rand -base64 32`.
# Development falls back to a fixed dev-only value with a warning.
CONSOLE_COOKIE_SECRET=
